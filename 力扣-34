class Solution {
    int bSearch(vector<int>& nums,int t){
        int l=-1,r=nums.size();
        while(l+1<r){
            int mid=(l+r)/2;
            if(nums[mid]>=t){
                r=mid;
            }else{
                l=mid;
            }
        }
        return r;
    }

public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int idx=bSearch(nums,target);
        if(idx==nums.size()){
            return {-1,-1};
        }
        if(nums[idx]!=target){
            return {-1,-1};
        }
        vector<int> ans;
        ans.push_back(idx);
        int idx1=bSearch(nums,target+1);
        ans.push_back(idx1-1);
        return ans;
        
    }
};
