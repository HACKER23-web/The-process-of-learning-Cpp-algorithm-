#include <iostream>
using namespace std;
int main()
{
  int n;
  cin>>n;
  int arr[100001];
  int hash[100001]={0};
  int visit[100001]={0};
  int res=0;
  for(int i=0;i<n;i++){
    cin>>arr[i];
    hash[arr[i]]=1;
  }
  for(int i=0;i<n;i++){
    visit[arr[i]]++;
    if(hash[arr[i]]==1&&visit[arr[i]]==1){
      if(hash[arr[i]+1]==1&&hash[arr[i]+2]==1){
        res++;
      }
    }
  }
  cout<<res<<endl;
  return 0;
}
