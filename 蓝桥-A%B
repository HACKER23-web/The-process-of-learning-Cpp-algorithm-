#include <iostream>
using namespace std;
int main()
{
  int n;
  cin>>n;
  long long a[1000][2];
  for(int i=0;i<n;i++){
    cin>>a[i][0]>>a[i][1];
  }
  for(int i=0;i<n;i++){
    int x=a[i][0];
    int y=a[i][1];
    int m=abs(y);
    int n=x%y;
    if(n<0){
      n+=m;
    }
    cout<<n<<endl;
  }

}
