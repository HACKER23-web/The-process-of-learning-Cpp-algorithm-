#include <iostream>
#include <algorithm>
using namespace std;

int a[200001];
int b[200001];
int c[200001];
int main()
{
  int n;
  cin>>n;
  for(int i=0;i<n;i++){
    cin>>a[i];
    c[i]=2*a[i];
  }
  for(int i=0;i<n;i++){
    cin>>b[i];
  }
  sort(b,b+n);
  sort(c,c+n);
  int i=0,j=0;
  int cnt=0;
  while(i<n&&j<n){
    if(c[i]>b[j]){
      i++,j++;
      cnt++;
    }else{
      i++;
    }
  }
  cout<<cnt<<endl;

  return 0;
}
