#include <iostream>
#include <vector>
using namespace std;

const long long MOD=1000000007;

int main()
{
  long long n,k;
  cin>>n>>k;
  vector<long long> arr(n+1,0);
  arr[0]=0,arr[1]=1;
  long long sum=1;
  for(long long i=2;i<=n;i++){
    arr[i]=sum;
    if(i<=k){
      arr[i]=(arr[i]+1)%MOD;
    }
    sum+=arr[i];
    if(i>k){
      sum-=arr[i-k];
    }
    sum%=MOD;
    if(sum<0){
      sum+=MOD;
    }
  }
  cout<<arr[n]%MOD<<endl;
  return 0;
}

